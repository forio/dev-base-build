{
  "variables": {
    "Step": {
      "save": true
    },
    "Time": {
      "save": true
    },
    "Report_Profit": {
      "save": true
    }
  },
  "protections": {
    "guards": [
      {
        "role": {
          "regex": "^(Price|Demand)(\\[.*\\])?$",
          "domain": "variable",
          "grant": "allow",
          "role": "Sales"
        }
      },
      {
        "role": {
          "regex": "^(Capacity|Variable_Cost)(\\[.*\\])?$",
          "domain": "variable",
          "grant": "allow",
          "role": "Operations"
        }
      },
      {
        "role": {
          "regex": "^Fixed_Costs(\\[.*\\])?$",
          "domain": "variable",
          "grant": "allow",
          "role": "Finance"
        }
      }
    ]
  }
}
