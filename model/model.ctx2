{
  "language": "python3",
  "restorations": {
    "assembly": [
      {
        "snapshot": {
          "variables": [
            "state"
          ]
        }
      }
    ]
  },
  "protections": {
    "guards": [
      {
        "privilege": {
          "regex": "^creator$",
          "domain": "variable",
          "grant": "disallow",
          "read": "PARTICIPANT",
          "write": "PARTICIPANT",
          "execute": "PARTICIPANT"
        }
      }
    ]
  }
}
