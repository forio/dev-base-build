{
  "variables": {
    "Price": {
      "save": true
    },
    "Revenue": {
      "save": true
    },
    "Total_Costs": {
      "save": true
    },
    "Profit": {
      "save": true
    },
    "Step": {
      "save": true
    },
    "Time": {
      "save": true
    }
  },
  "protections": {
    "guards": [
      {
        "privilege": {
          "regex": "^creator$",
          "domain": "variable",
          "grant": "disallow",
          "read": "PARTICIPANT",
          "write": "PARTICIPANT",
          "execute": "PARTICIPANT"
        }
      }
    ]
  }
}
