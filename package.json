    "deploy:proxy": "tsx cli/deploy.ts proxy && tsx cli/reset-proxy.ts",
    "reset:proxy": "tsx cli/reset-proxy.ts",
    "deploy": "npm-run-all build deploy:*",
    "prepare": "husky"
  },
