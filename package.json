    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "epicenter-libs": "^3.32.0",
    "husky": "^9.1.7",
    "i18next": "^25.6.0",
    "jotai": "^2.15.0",
    "lucide-react": "^0.548.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
